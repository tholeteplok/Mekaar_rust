{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MEKAAR",
  "version": "0.1.0",
  "identifier": "com.mekaar.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "MEKAAR Native",
        "width": 1080,
        "height": 750,
        "minWidth": 400,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
